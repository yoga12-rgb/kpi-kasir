# Supabase URL & keys
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key (jangan pernah dipakai di client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated allowlist for OAuth callback origins in production.
APP_ORIGIN_ALLOWLIST=http://localhost:3000

# Proteksi cron endpoints
CRON_SECRET=change-me-to-a-long-random-string

# Bukti foto pendampingan (aktifkan setelah migration, Storage, dan smoke test siap)
MENTORING_EVIDENCE_UPLOAD_ENABLED=false

# Google OAuth (opsional, dikonfigurasi via Supabase Dashboard)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
